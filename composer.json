{
	"name": "mediawiki/themetoggle",
	"description": "Allows the site to create local themes. Tuned for setups with aggressive caching, where a cookie-based solution might poison the cache.",
	"type": "mediawiki-extension",
	"keywords": [
		"MediaWiki"
	],
	"homepage": "https://gitlab.mglolenstine.xyz/alex4401/mediawiki-extension-themetoggle",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "alex4401",
			"email": "rylatgl@gmail.com"
		}
	],
	"require-dev": {
		"mediawiki/mediawiki-codesniffer": "52.0.1",
		"mediawiki/mediawiki-phan-config": "0.20.0",
		"mediawiki/minus-x": "2.0.1",
		"php-parallel-lint/php-console-highlighter": "1.0.0",
		"php-parallel-lint/php-parallel-lint": "1.4.0"
	},
	"scripts": {
		"test": [
			"parallel-lint . --exclude vendor --exclude node_modules",
			"@phpcs",
			"minus-x check ."
		],
		"fix": [
			"minus-x fix .",
			"phpcbf"
		],
		"phan": "phan -d . --long-progress-bar",
		"phpcs": "phpcs -sp --cache"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"audit": {
			"block-insecure": false
		}
	}
}
